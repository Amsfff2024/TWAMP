        { vendor: "Huawei", circle: "JAYA", date: "3/1/2026", user: "junaedi.te@pmt.co.id", partner: "PMT", ticket: "CM-20260301-00001074", cmStatus: "Closed", fmeSuccess: 11, totalAccess: 29, sr: "37.93%", remark: "Access & Good Result", fmeAccess: "Yes", successRateRemark: "Low Success Rate", usage: "Low Usage", status: "Low Usage-Low Success Rate" },
        { vendor: "Huawei", circle: "JAYA", date: "3/1/2026", user: "ilham.amin@persada.id", partner: "Persada", ticket: "CM-20260301-00000436", cmStatus: "Closed", fmeSuccess: 10, totalAccess: 36, sr: "27.78%", remark: "Access & Good Result", fmeAccess: "Yes", successRateRemark: "Low Success Rate", usage: "High Usage", status: "High Usage-Low Success Rate" }
    ];

    let filteredData = [...rawData];
    let currentSortField = 'user';
    let currentSortDir = 'asc';
    let charts = {};
    let fmeChart = null;

    function updateClock() {
        const now = new Date();
        document.getElementById('liveClock').innerText = now.toLocaleTimeString('en-GB');
    }
    setInterval(updateClock, 1000);
    updateClock();

    function getUsageValue(usage) {
        if (usage === "Low Usage") return 1;
        if (usage === "Medium Usage") return 2;
        if (usage === "High Usage") return 3;
        return 1;
    }

    function getSuccessRateValue(remark) {
        if (remark === "Low Success Rate") return 1;
        if (remark === "Medium Success Rate") return 2;
        if (remark === "High Success Rate") return 3;
        return 1;
    }

    function getQuadrant(usage, success) {
        const usageVal = getUsageValue(usage);
        const successVal = getSuccessRateValue(success);
        if (usageVal <= 1.5 && successVal <= 1.5) return "Critical";
        if (usageVal > 1.5 && successVal <= 1.5) return "Need Attention";
        if (usageVal > 1.5 && successVal > 1.5) return "Good";
        return "Potential";
    }

    function applyFilters() {
        const searchTerm = document.getElementById('searchUser').value.toLowerCase();
        const statusFilter = document.getElementById('filterStatus').value;
        const circleFilter = document.getElementById('filterCircle').value;
        const partnerFilter = document.getElementById('filterPartner').value;

        filteredData = rawData.filter(item => {
            if (searchTerm && !item.user.toLowerCase().includes(searchTerm) && !item.partner.toLowerCase().includes(searchTerm)) return false;
            if (statusFilter && item.cmStatus !== statusFilter) return false;
            if (circleFilter && item.circle !== circleFilter) return false;
            if (partnerFilter && item.partner !== partnerFilter) return false;
            return true;
        });
        updateKPIs();
        updateFMEQuadrant();
        updateCharts();
        if (document.getElementById('detailTablePanel').style.display === 'block') {
            applyDetailFilters();
        }
    }

    function updateKPIs() {
        const uniqueUsers = new Set(filteredData.map(d => d.user)).size;
        const openCount = filteredData.filter(d => d.cmStatus === 'Open').length;
        const closedCount = filteredData.filter(d => d.cmStatus === 'Closed').length;
        
        document.getElementById('kpiTotal').innerText = filteredData.length;
        document.getElementById('kpiUsers').innerText = uniqueUsers;
        document.getElementById('kpiOpen').innerText = openCount;
        document.getElementById('kpiClosed').innerText = closedCount;
    }

    function updateFMEQuadrant() {
        const datasets = [
            { label: '🔴 Critical', data: [], backgroundColor: '#ff6b6b', borderColor: '#ff6b6b', pointRadius: 10, pointHoverRadius: 14 },
            { label: '🟡 Need Attention', data: [], backgroundColor: '#ffd93d', borderColor: '#ffd93d', pointRadius: 10, pointHoverRadius: 14 },
            { label: '🟢 Good', data: [], backgroundColor: '#6bcb77', borderColor: '#6bcb77', pointRadius: 10, pointHoverRadius: 14 },
            { label: '🔵 Potential', data: [], backgroundColor: '#4d96ff', borderColor: '#4d96ff', pointRadius: 10, pointHoverRadius: 14 }
        ];

        let stats = { critical: 0, needAttention: 0, good: 0, potential: 0 };
        
        // Group by user untuk menghindari duplikasi di chart
        const uniqueUsers = new Map();
        filteredData.forEach(item => {
            const key = item.user;
            if (!uniqueUsers.has(key)) {
                uniqueUsers.set(key, item);
            }
        });

        uniqueUsers.forEach(item => {
            const quadrant = getQuadrant(item.usage, item.successRateRemark);
            let datasetIndex = 0;
            if (quadrant === "Critical") { datasetIndex = 0; stats.critical++; }
            else if (quadrant === "Need Attention") { datasetIndex = 1; stats.needAttention++; }
            else if (quadrant === "Good") { datasetIndex = 2; stats.good++; }
            else { datasetIndex = 3; stats.potential++; }
            
            datasets[datasetIndex].data.push({
                x: getUsageValue(item.usage),
                y: getSuccessRateValue(item.successRateRemark),
                user: item.user,
                partner: item.partner,
                circle: item.circle,
                ticket: item.ticket,
                totalAccess: item.totalAccess,
                usage: item.usage,
                successRate: item.successRateRemark,
                cmStatus: item.cmStatus
            });
        });

        document.getElementById('statCritical').innerText = stats.critical;
        document.getElementById('statNeedAttention').innerText = stats.needAttention;
        document.getElementById('statGood').innerText = stats.good;
        document.getElementById('statPotential').innerText = stats.potential;

        if (fmeChart) fmeChart.destroy();

        const ctx = document.getElementById('fmeQuadrantChart').getContext('2d');
        fmeChart = new Chart(ctx, {
            type: 'scatter',
            data: { datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const point = context.raw;
                                return [
                                    `👤 User: ${point.user}`,
                                    `🏢 Partner: ${point.partner}`,
                                    `📍 Circle: ${point.circle}`,
                                    `🎫 Ticket: ${point.ticket}`,
                                    `📊 Total Access: ${point.totalAccess}`,
                                    `📈 Usage: ${point.usage}`,
                                    `✅ Success Rate: ${point.successRate}`,
                                    `📌 Status: ${point.cmStatus}`
                                ];
                            }
                        }
                    },
                    annotation: {
                        annotations: {
                            lineX: {
                                type: 'line',
                                xMin: 1.5,
                                xMax: 1.5,
                                borderColor: '#e94560',
                                borderWidth: 2,
                                borderDash: [5, 5],
                                label: { content: 'Median Usage', enabled: true, position: 'end', color: '#e94560', font: { size: 10 } }
                            },
                            lineY: {
                                type: 'line',
                                yMin: 1.5,
                                yMax: 1.5,
                                borderColor: '#e94560',
                                borderWidth: 2,
                                borderDash: [5, 5],
                                label: { content: 'Median Success', enabled: true, position: 'end', color: '#e94560', font: { size: 10 } }
                            }
                        }
                    },
                    legend: { position: 'bottom', labels: { font: { size: 10 } } }
                },
                scales: {
                    x: {
                        title: { display: true, text: 'Usage Rate (1=Low, 2=Medium, 3=High)', font: { size: 11 } },
                        min: 0.5, max: 3.5,
                        ticks: {
                            stepSize: 0.5,
                            callback: function(val) {
                                if (val === 1) return 'Low';
                                if (val === 2) return 'Medium';
                                if (val === 3) return 'High';
                                return val;
                            }
                        }
                    },
                    y: {
                        title: { display: true, text: 'Success Rate (1=Low, 2=Medium, 3=High)', font: { size: 11 } },
                        min: 0.5, max: 3.5,
                        ticks: {
                            stepSize: 0.5,
                            callback: function(val) {
                                if (val === 1) return 'Low';
                                if (val === 2) return 'Medium';
                                if (val === 3) return 'High';
                                return val;
                            }
                        }
                    }
                }
            }
        });
    }

    function updateCharts() {
        // Status Chart
        const open = filteredData.filter(d => d.cmStatus === 'Open').length;
        const closed = filteredData.filter(d => d.cmStatus === 'Closed').length;
        if (charts.status) charts.status.destroy();
        charts.status = new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: { labels: ['Open', 'Closed'], datasets: [{ data: [open, closed], backgroundColor: ['#dc2626', '#10b981'], borderWidth: 0 }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } }, datalabels: { color: 'white', font: { weight: 'bold', size: 12 }, formatter: (val, ctx) => { let total = ctx.dataset.data.reduce((a, b) => a + b, 0); return total ? ((val / total) * 100).toFixed(1) + '%' : ''; } } } }
        });

        // Partner Chart
        const partnerMap = new Map();
        filteredData.forEach(d => { partnerMap.set(d.partner, (partnerMap.get(d.partner) || 0) + 1); });
        const sortedPartner = Array.from(partnerMap.entries()).sort((a, b) => b[1] - a[1]).slice(0, 5);
        if (charts.partner) charts.partner.destroy();
        charts.partner = new Chart(document.getElementById('partnerChart'), {
            type: 'bar',
            data: { labels: sortedPartner.map(p => p[0]), datasets: [{ data: sortedPartner.map(p => p[1]), backgroundColor: '#2ba6cb', borderRadius: 8 }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { datalabels: { anchor: 'end', align: 'top', color: '#000', font: { size: 10 }, formatter: (v) => v }, legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 10 } } } } }
        });

        // Circle Chart
        const circleMap = new Map();
        filteredData.forEach(d => { circleMap.set(d.circle, (circleMap.get(d.circle) || 0) + 1); });
        const sortedCircle = Array.from(circleMap.entries()).sort((a, b) => b[1] - a[1]);
        if (charts.circle) charts.circle.destroy();
        charts.circle = new Chart(document.getElementById('circleChart'), {
            type: 'pie',
            data: { labels: sortedCircle.map(c => c[0]), datasets: [{ data: sortedCircle.map(c => c[1]), backgroundColor: ['#0ea5e9', '#8b5cf6', '#f59e0b', '#ef4444', '#10b981'] }] },
            options: { responsive: true, maintainAspectRatio: true, plugins: { datalabels: { color: 'white', font: { size: 10 }, formatter: (val, ctx) => { let total = ctx.dataset.data.reduce((a, b) => a + b, 0); return total ? ((val / total) * 100).toFixed(1) + '%' : ''; } }, legend: { position: 'right', labels: { font: { size: 10 } } } } }
        });

        // Correlation Chart (Usage vs Success Rate)
        const usageMap = { 'Low Usage': 0, 'Medium Usage': 0, 'High Usage': 0 };
        const successMap = { 'Low Success Rate': 0, 'Medium Success Rate': 0, 'High Success Rate': 0 };
        filteredData.forEach(d => {
            usageMap[d.usage]++;
            successMap[d.successRateRemark]++;
        });
        if (charts.correlation) charts.correlation.destroy();
        charts.correlation = new Chart(document.getElementById('correlationChart'), {
            type: 'bar',
            data: {
                labels: ['Low', 'Medium', 'High'],
                datasets: [
                    { label: 'Usage Rate', data: [usageMap['Low Usage'], usageMap['Medium Usage'], usageMap['High Usage']], backgroundColor: '#3b82f6', borderRadius: 8 },
                    { label: 'Success Rate', data: [successMap['Low Success Rate'], successMap['Medium Success Rate'], successMap['High Success Rate']], backgroundColor: '#10b981', borderRadius: 8 }
                ]
            },
            options: { responsive: true, maintainAspectRatio: true, plugins: { datalabels: { anchor: 'end', align: 'top', color: '#000', font: { size: 10 }, formatter: (v) => v }, legend: { position: 'top', labels: { font: { size: 10 } } } }, scales: { y: { beginAtZero: true, ticks: { font: { size: 10 } } }, x: { ticks: { font: { size: 10 } } } } }
        });
    }

    function applyDetailFilters() {
        let detailFiltered = [...filteredData];
        const filterVendor = document.getElementById('filterVendor')?.value.toLowerCase() || '';
        const filterCircle = document.getElementById('filterCircleDet')?.value.toLowerCase() || '';
        const filterUser = document.getElementById('filterUser')?.value.toLowerCase() || '';
        const filterPartner = document.getElementById('filterPartnerDet')?.value.toLowerCase() || '';
        const filterTicket = document.getElementById('filterTicket')?.value.toLowerCase() || '';
        const filterStatus = document.getElementById('filterDetailStatus')?.value || '';
        const filterSuccessRate = document.getElementById('filterSuccessRate')?.value.toLowerCase() || '';
        const filterUsage = document.getElementById('filterUsage')?.value.toLowerCase() || '';

        detailFiltered = detailFiltered.filter(item => {
            if (filterVendor && !item.vendor.toLowerCase().includes(filterVendor)) return false;
            if (filterCircle && !item.circle.toLowerCase().includes(filterCircle)) return false;
            if (filterUser && !item.user.toLowerCase().includes(filterUser)) return false;
            if (filterPartner && !item.partner.toLowerCase().includes(filterPartner)) return false;
            if (filterTicket && !item.ticket.toLowerCase().includes(filterTicket)) return false;
            if (filterStatus && item.cmStatus !== filterStatus) return false;
            if (filterSuccessRate && !item.successRateRemark.toLowerCase().includes(filterSuccessRate)) return false;
            if (filterUsage && !item.usage.toLowerCase().includes(filterUsage)) return false;
            return true;
        });

        detailFiltered.sort((a, b) => {
            let aVal = a[currentSortField], bVal = b[currentSortField];
            if (typeof aVal === 'string') return currentSortDir === 'asc' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
            return 0;
        });
        renderDetailTable(detailFiltered);
        document.getElementById('detailCountBadge').innerHTML = `${detailFiltered.length} rows`;
    }

    function renderDetailTable(data) {
        const tbody = document.getElementById('detailTableBody');
        if (!data.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4">No matching records</td></tr>';
            return;
        }
        tbody.innerHTML = data.map(item => `
            <tr>
                <td>${escapeHtml(item.vendor)}</td>
                <td>${escapeHtml(item.circle)}</td>
                <td style="max-width: 200px; word-break: break-word;">${escapeHtml(item.user)}</td>
                <td>${escapeHtml(item.partner)}</td>
                <td style="font-family: monospace; font-size: 0.7rem;">${escapeHtml(item.ticket)}</td>
                <td><span class="${item.cmStatus === 'Open' ? 'badge-open' : 'badge-closed'}">${item.cmStatus}</span></td>
                <td><span class="badge ${item.successRateRemark === 'High Success Rate' ? 'bg-success' : item.successRateRemark === 'Low Success Rate' ? 'bg-danger' : 'bg-warning'} text-white">${item.successRateRemark}</span></td>
                <td><span class="badge ${item.usage === 'High Usage' ? 'bg-success' : item.usage === 'Low Usage' ? 'bg-danger' : 'bg-warning'} text-white">${item.usage}</span></td>
            </tr>
        `).join('');
    }

    function sortBy(field) {
        if (currentSortField === field) currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
        else { currentSortField = field; currentSortDir = 'asc'; }
        applyDetailFilters();
    }

    function clearColumnFilters() {
        const filterIds = ['filterVendor', 'filterCircleDet', 'filterUser', 'filterPartnerDet', 'filterTicket', 'filterDetailStatus', 'filterSuccessRate', 'filterUsage'];
        filterIds.forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
        applyDetailFilters();
    }

    function escapeHtml(str) { if (!str) return ''; return String(str).replace(/[&<>]/g, function (m) { if (m === '&') return '&amp;'; if (m === '<') return '&lt;'; if (m === '>') return '&gt;'; return m; }); }

    function showDetailTable() {
        document.getElementById('detailTablePanel').style.display = 'block';
        const filterIds = ['filterVendor', 'filterCircleDet', 'filterUser', 'filterPartnerDet', 'filterTicket', 'filterDetailStatus', 'filterSuccessRate', 'filterUsage'];
        filterIds.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.removeEventListener('input', applyDetailFilters);
            if (el && (el.tagName === 'INPUT' || el.tagName === 'SELECT')) {
                el.addEventListener('input', applyDetailFilters);
                el.addEventListener('change', applyDetailFilters);
            }
        });
        applyDetailFilters();
    }

    function hideDetailTable() { document.getElementById('detailTablePanel').style.display = 'none'; }

    function resetFilters() {
        document.getElementById('searchUser').value = '';
        document.getElementById('filterStatus').value = '';
        document.getElementById('filterCircle').value = '';
        document.getElementById('filterPartner').value = '';
        applyFilters();
    }

    function exportCSV() {
        if (!filteredData.length) return alert('No data to export');
        const headers = ['Vendor', 'Circle', 'Date', 'User', 'Vendor Partner', 'CM Ticket', 'CM Status', 'FME Success', 'Total Access', 'SR', 'Remark', 'FME Access', 'Success Rate Remark', 'Usage', 'Status'];
        const rows = filteredData.map(d => [d.vendor, d.circle, d.date, d.user, d.partner, d.ticket, d.cmStatus, d.fmeSuccess, d.totalAccess, d.sr, d.remark, d.fmeAccess, d.successRateRemark, d.usage, d.status]);
        const csvContent = [headers.join(','), ...rows.map(r => r.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(','))].join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `fme_copilot_data_${new Date().toISOString().slice(0, 19)}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
    }

    // Initialize filter dropdowns
    function initFilters() {
        const circles = [...new Set(rawData.map(d => d.circle))];
        const partners = [...new Set(rawData.map(d => d.partner))];
        const circleSelect = document.getElementById('filterCircle');
        const partnerSelect = document.getElementById('filterPartner');
        circles.forEach(c => { const opt = document.createElement('option'); opt.value = c; opt.innerText = c; circleSelect.appendChild(opt); });
        partners.forEach(p => { const opt = document.createElement('option'); opt.value = p; opt.innerText = p; partnerSelect.appendChild(opt); });
        
        // Also for detail table partner filter
        const partnerDetSelect = document.getElementById('filterPartnerDet');
        if (partnerDetSelect) {
            partnerDetSelect.innerHTML = '<option value="">All Partners</option>';
            partners.forEach(p => { const opt = document.createElement('option'); opt.value = p; opt.innerText = p; partnerDetSelect.appendChild(opt); });
        }
    }

    // Event listeners
    document.getElementById('searchUser').addEventListener('input', () => applyFilters());
    document.getElementById('filterStatus').addEventListener('change', () => applyFilters());
    document.getElementById('filterCircle').addEventListener('change', () => applyFilters());
    document.getElementById('filterPartner').addEventListener('change', () => applyFilters());

    initFilters();
    applyFilters();
</script>
